{
  "name": "kora-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx src/seed/run.ts",
    "smoke": "tsx src/seed/smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.7.10",
    "pg": "^8.16.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "drizzle-kit": "^0.31.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
