# Kora backend secrets — copy to .env
DATABASE_URL=postgresql://kora:kora-dev-pw@127.0.0.1:5432/kora_market
JWT_SECRET=change-me-to-32-random-bytes
PORT=4001

# Paystack — leave empty to run in local/no-pay stack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Paystack webhook signature secret is PAYSTACK_SECRET_KEY (HMAC-SHA512)
KORA_FRONTEND_URL=http://localhost:3000
